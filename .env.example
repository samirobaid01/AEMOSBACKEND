# ──────────────────────────────────────────────
# P4 — Pluggable Data Layer
# ──────────────────────────────────────────────

# Time-series backend: mysql (default, no extra setup) | timescale | influx
TIMESERIES_BACKEND=mysql

# TimescaleDB (required when TIMESERIES_BACKEND=timescale)
TSDB_HOST=localhost
TSDB_PORT=5432
TSDB_NAME=aemos_timeseries
TSDB_USER=aemos
TSDB_PASSWORD=changeme
TSDB_POOL_MAX=20

# InfluxDB v2 (required when TIMESERIES_BACKEND=influx)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=changeme
INFLUX_ORG=aemos
INFLUX_BUCKET=datastream

# Socket.io Redis adapter — set true to enable multi-node WebSocket fan-out
SOCKET_REDIS_ADAPTER=false

# Redis Sentinel (optional — leave unset for standalone Redis)
# REDIS_SENTINEL_HOSTS=host1:26379,host2:26379,host3:26379
# REDIS_SENTINEL_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=changeme
